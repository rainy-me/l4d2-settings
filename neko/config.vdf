// 수정 후 이 파일을 config.vdf로 저장해야 합니다
// 버전 업데이트로 설정 항목이 추가된 경우, config_template.vdf를 확인하여 새 설정 항목의 예시를 참고해야 할 수 있습니다
// Valve KeyValue Format
"config" {
    // 1은 예, 0은 아니오를 의미합니다
    // "//"는 주석을 나타내며, "//"부터 줄 끝까지의 내용은 무시됩니다

    // !!!  문법 오류가 있으면 설정 파일이 무효화됩니다  !!!!
    // 자신이 무엇을 하는지 확실히 알지 못한다면 일부 구간을 잘라내거나 삭제하지 마세요
    // config.vdf의 형식은 autoexec.cfg와 다릅니다. config_template.vdf의 형식에 맞춰 수정하세요

    // 환경 변수 설정
    "environment_variables" {
        // vulkan loader의 환경 변수
        // DXVK와 ReShade Bridge를 사용하는 경우, 아래 두 매개변수로 메모리 점유 이상 문제를 해결할 수 있습니다. 아래 두 줄 앞의 "//"를 삭제하면 매개변수가 적용됩니다
        // "VK_LOADER_LAYERS_DISABLE" "*"               // 블랙리스트. 매개변수 "*"는 vulkan layer 메커니즘에 의존하는 모든 기능을 비활성화합니다. 예: RTSS(MSI Afterburner), OBS 게임 캡처, ReShade
        // "VK_LOADER_LAYERS_ENABLE" "*reshade*,*obs*"  // 화이트리스트. 블랙리스트보다 우선순위가 높습니다
        // 정확한 원인은 아직 밝혀지지 않았지만 확실히 문제가 해결됩니다...

        // "DISABLE_VK_LAYER_reshade_1" "1" // vulkan 모드에서 ReShade를 완전히 비활성화
    }

    // 사용자 지정 명령. l4n_custom_command_menu로 엽니다
    "custom_commands" {
        "1인칭 엔티티 렌더링" { "cvar" "r_drawviewmodel" }
        "총구 흔들림 비활성화" { "cmd" "l4n_cvar z_gun_vertical_punch 0" }
        "실행 옵션 출력" { "cmd" "l4n_print_launch_options" }
        "실행 환경 정보 출력" { "cmd" "l4n_env_report" }
        // 유용한 명령어
        // l4n_open_shader_cache_dir 
        // l4n_reload_config 
    }

    // 게임 설정-키 바인딩의 사용자 지정 항목
    "key_bind_acts" {
        "사용자 지정 명령 메뉴" "l4n_custom_command_menu"
        "조준점에 동적 광원 배치(두 번 누르면 삭제)" "l4n_placelight"
        "l4n 메뉴" "l4n_menu"
        "무기 손 뻗기 애니메이션 발동(랜덤)" "+l4n_lookat"
        "무기 손 뻗기 애니메이션 발동(아이템)" "+l4n_lookat itempickup"
        "무기 손 뻗기 애니메이션 발동(부축)" "+l4n_lookat helpinghand"
        "대형 스코어보드(두 번 누르면 원본 표시)" "+l4n_player_list"
        "원본 스코어보드(두 번 누르면 대형 표시)" "+l4n_player_list 1"
        "HUD 표시/숨기기" "toggle l4n_game_hud_visible"
        "3인칭 전환"  "thirdpersonshoulder"
    }

    // 엔진 내장 브라우저 커널을 비활성화할지 여부. 메모리 점유를 100MB 정도 절약할 수 있습니다
    // 일부 서버의 환영 페이지가 표시되지 않게 됩니다
    "disable_chromehtml" "0"

    // Too many indices for index buffer 팝업을 방지하는 데 사용됩니다
    // 2로 조정한 뒤 게임에 들어가 효과를 테스트할 수 있습니다. 기본값(32768)이 아닌 경우 가끔 장면의 폴리곤이 깨져 화면이 얼룩질 수 있으며, 이는 감수해야 하는 대가입니다
    // 비슷한 패치를 적용했다면 기본값을 유지하면 됩니다
    "index_buffer_size" "32768" // 폴리곤 깨짐은 수치 크기와 관련이 있는 것으로 보이며, 32768의 배수를 시도해볼 수 있습니다: 65535 131072

    // vertex buffer 관련 팝업은 매우 드뭅니다. 부득이한 경우가 아니라면, 기본값(32768)보다 크게 하면 폴리곤 깨짐과 화면 얼룩이 발생합니다
    "vertex_buffer_size" "32768" // 권장값 65535

    "font" // 글꼴 설정
    {
        "anti_aliasing" "1"
        //"min_tall" "20" // 글꼴의 최소 크기. 게임 내 일부 텍스트가 너무 작아지는 것을 방지합니다
        "replace" // 글꼴 교체 목록
        {
            // 작성법: "교체될 글꼴" "대체 글꼴" 
            // Tahoma를 Microsoft YaHei(微软雅黑)로 교체하는 예시. 중국어 간체의 기본 글꼴은 Tahoma입니다
            // "Tahoma" "微软雅黑" 

            // 일부 HUD 모드는 기본 글꼴을 다른 것으로 변경합니다. HUD 모드를 언팩하여 사용 중인 글꼴 이름을 확인한 뒤 교체할 수 있습니다
            // "HUD가 사용하는 글꼴 이름" "微软雅黑" 

            // english의 기본 글꼴은 L4D 시리즈의 낡은 스타일에 어울리는 Stubble bold입니다
            "Stubble bold" "Pretendard Black"
            "맑은 고딕" "Pretendard Black"
            "Malgun Gothic" "Pretendard Black"
        }
    }

    // !!! steam 페이지 속성의 시작 옵션도 정상적으로 적용됩니다. 단, 게임을 steam을 통해 실행하지 않는 경우는 예외입니다
    // !!! l4n을 비활성화했다면 이 파일에 추가한 시작 옵션은 무효화됩니다
    // !!! -hide_neko 시작 옵션은 여기에 추가해도 적용되지 않습니다
    "launch_options"
    {
        +l4n_cvar "z_gun_vertical_punch 0"
        +l4n_cvar "r_drawmodeldecals 0"
        -l4n_use_neko_engine_post ""

        // 시작 옵션을 추가로 넣는 문법:
        // "-novid"는 다음과 같이 작성: "-novid" "" 
        // "+mat_phong 1"은 다음과 같이 작성: "+mat_phong" "1" 
        // "-novid" "" // 게임 시작 시 나오는 Valve 애니메이션과 맛있는 초콜릿 헬리콥터를 끕니다

        // "-lv" "" // 저혈흔 모드. 이름 그대로입니다. 몸에 달라붙는 혈흔 데칼 효과가 생성되지 않습니다(스프레이와 비슷하며, 피 튀김 파티클 효과와 혼동하지 마세요. 데칼은 모드가 적용된 캐릭터 모델에서 크래시를 일으키기 쉽습니다. 예: hunter와 witch의 공격으로 인한 크래시)

        // 모델 위에 데칼 생성 금지
        // +l4n_cvar "r_drawmodeldecals 0" 

        // "-condebug" ""       //콘솔의 내용을 left4dead2/console.log로 전부 출력합니다
        // "-conclearlog" ""    //게임 시작 시 console.log의 내용을 지웁니다. 이 시작 옵션은 버그로 적용되지 않는데, l4n 사용 시 이 문제가 수정됩니다

        // 아래는 l4n 관련 시작 옵션입니다
            // "-hide_addons" ""            // 엔진이 addons 디렉터리의 파일을 읽는 것을 금지합니다
            // -l4n_use_neko_engine_post "" // 추가하면 l4n이 엔진의 후처리 렌더링을 대신 처리합니다
            // "-no_l4n_gui" "" 
            // "-no_l4n_vgui" "" 
            // "-mat_utf8" "" 

            // 아래 시작 옵션은 config.vdf 파일에 추가할 수 없습니다. steam 게임 속성이나 다른 방식(bat, 바로가기)으로 설정하세요
            // -hide_neko                   // l4n 비활성화. 플랫폼이 성공적으로 비활성화되면 이 설정 파일은 무효가 됩니다
            // -hide_nekoshaders            // l4n의 셰이더 비활성화
            // -l4n_no_compatibility_check  // 게임 버전 검사 금지
    }

    // l4n_menu를 "\" 키에 강제로 바인딩할지 여부
    "force_bind_l4n_menu" "1"

    // datacache의 상한을 2048MB로 강제 설정
    "lock_datacache_size" "1"

// ==================== 자신이 무엇을 하는지 확실히 알지 못한다면, 이 줄부터 파일 끝까지의 내용을 수정하지 마세요 ========================

    // 엔진 tier0 내장 메모리 할당자를 mimalloc 메모리 할당자로 교체할지 여부. 일부 상황에서 메모리 단편화를 줄여줍니다
    // 이 기능은 실험적이며, 게임의 메모리 수요 할당을 위해 큰 메모리 블록을 미리 확보합니다
    // 평소 DC 점유가 높은 편이라면 이 기능 사용을 권장하지 않습니다. 이 기능은 현재 dxvk의 메모리 할당자를 교체하지 않기 때문에 메모리 부족 크래시가 발생하기 쉽습니다
    "mimalloc" "0"

    "wave_cache_max_kilobytes" "524288" // 512mb

    "generate_addoninfo" "1"

    "survivors" {
        "nick" {
            // l4n_survivor_sequence_strip은 번호가 max_sequences보다 큰 애니메이션을 잘라내어, 확장된 애니메이션이 호출되는 것을 방지합니다
            "max_sequences" "923"
        }
        "ellis" {
            "max_sequences" "927"
        }
        "rochelle" {
            "max_sequences" "930"
        }
        "coach" {
            "max_sequences" "912"
        }
        "bill" {
            "max_sequences" "1013"
        }
        "louis" {
            "max_sequences" "1013"
        }
        "francis" {
            "max_sequences" "1016"
        }
        "zoey" {
            "max_sequences" "947"
        }
    }

    // 생존자 캐릭터마다 사용하는 애니메이션이 서로 다르며, 총 여덟 세트의 캐릭터 애니메이션이 있습니다

    // 대부분의 경우 이 애니메이션들은 bill과 겹치는 부분이 있지만, 일부 애니메이션은 특정 캐릭터 전용입니다. 예를 들어 1편/2편 일부 맵의 오프닝 캐릭터 애니메이션이 그렇습니다

    // bill은 기준(아담)입니다. zoey를 제외한 나머지 캐릭터의 골격은 사실 bill의 등비율 스케일입니다. bill의 동작이 군인 표준이기 때문에, Valve는 다른 캐릭터의 애니메이션을 제작할 때 모두 bill의 애니메이션을 바탕으로 삼고, 그 위에 캐릭터 개성을 약간 추가했습니다. 예: ellis의 권총 드는 동작, coach의 건들거리는 걸음걸이

    // 애니메이션 가져오기 메커니즘: 같은 이름의 애니메이션이 존재하면 가져오지 않고, 그렇지 않으면 끝에 확장하여 가져옵니다. 이름 선언으로 애니메이션 가져오기 순서를 제어할 수 있지만, 특정 이름의 애니메이션 가져오기를 금지할 수는 없습니다

    // 서버는 번호를 통해 클라이언트에 애니메이션을 동기화합니다. 예를 들어 zoey 애니메이션을 사용하여 coach를 교체하는 모델을 만든다고 할 때, 원본 coach의 6번 위치가 부축(拉人) 애니메이션이고 zoey의 부축 애니메이션 이름이 다르다면, zoey의 부축 애니메이션을 6번 위치에 배치하고 coach의 부축 애니메이션은 끝으로 옮겨야 합니다.
    // 원본 coach에 999개의 애니메이션이 있다면, 교체한 coach 모델은 1000개의 애니메이션을 갖게 됩니다. 이런 경우는 결코 드문 일이 아닙니다

    // 서버 측에서 캐릭터 애니메이션은 대부분 애니메이션 이름이 아니라 의미(Activity)를 통해 호출됩니다. 서버가 당신의 coach 모델에 같은 의미로 묶인 애니메이션이 두 개 있는 것을 발견하면 그 두 애니메이션 사이에서 무작위로 재생합니다. 싱글 플레이거나 자신이 방장이라면 자신이 서버라는 뜻이므로, coach의 애니메이션이 무작위로 걸리면 몸 크기가 아무렇게나 변하게 됩니다. coach는 캐릭터 중 키가 가장 큰 축에 속하고, zoey의 골격은 coach보다 작아서, coach 골격의 애니메이션을 그대로 재생하면 팔다리가 늘어납니다

    // 멀티 플레이는 또 다른 상황입니다. 대부분의 서버는 캐릭터 모드나 애니메이션 모드를 설치하지 않았고, 설치해서도 안 됩니다. 이런 조건에서 당신의 coach 모델의 1000번째 애니메이션은 절대 재생되지 않습니다. 서버가 번호를 통해 애니메이션 상태를 동기화하는데, 모드가 없는 서버에는 999개의 애니메이션만 있기 때문입니다

    // 자신이 서버인 경우(싱글 플레이, 방장):
    //      l4nsurvivor를 사용하면 클라이언트 측 플레이어 모델 교체이므로 확장된 애니메이션이 호출되는 것을 피할 수 있습니다. 만일에 대비해, 이때 일반 생존자 모드나 일부 애니메이션 모드를 설치하면 안 됩니다. 모드가 서버의 애니메이션 결정에 영향을 주지 않는다고 확신할 수 있는 경우는 예외입니다
    //      cvar l4n_survivor_sequence_strip을 1로 설정하면 확장된 애니메이션이 호출되는 것을 피할 수 있습니다
    // 멀티 플레이로 다른 사람의 서버에 들어가는 경우:
    //      멀티 플레이만 하고 모델 제작자가 qc에서 적절하게 처리했다면(예: USQC 템플릿), 이런 문제를 만나기 어렵거나 문제가 두드러지지 않습니다

}