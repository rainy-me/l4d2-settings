// 수정 후 이 파일을 config.vdf로 저장해야 합니다
// 버전 업데이트로 설정 항목이 추가된 경우, config_template.vdf를 확인하여 새 설정 항목의 예시를 참고해야 할 수 있습니다
// Valve KeyValue Format
"config" {
    // version 2
    // 1은 예, 0은 아니오를 의미합니다
    // "//"는 주석을 나타내며, "//"부터 줄 끝까지의 내용은 무시됩니다

    // !!!  문법 오류가 있으면 설정 파일이 무효화됩니다  !!!!
    // 자신이 무엇을 하는지 확실히 알지 못한다면 일부 구간을 잘라내거나 삭제하지 마세요
    // config.vdf의 형식은 autoexec.cfg와 다릅니다. config_template.vdf의 형식에 맞춰 수정하세요

    // VPK Overlay는 맵을 로드할 때마다 후보 라이브러리에서 서로 다른 VPK 모드를 무작위, 순서대로 또는 지정하여 자동으로 마운트합니다. 게임 재시작이 필요 없습니다
    // 예: 맵이 바뀔 때마다 다른 스킨의 총으로 자동 교체, 또는 다른 생존자 모델로 전환
    // 폴더를 하나 준비하고, 그 폴더의 경로를 아래 매개변수에 입력하세요
    "vpk_overlay" "E:\aaa\bbb\vpk_overlay_root"
    // vpk_overlay_root/                   <-- 루트 디렉터리
    // ├── Weapons_AK47/                   <-- Overlay 단위 (이름과 개수에 제한 없음. 여기서는 AK47 모드의 교체 라이브러리로 준비)
    // │   ├── Red_Skin.vpk                <-- 후보 1: 단일 VPK 파일
    // │   ├── Blue_Skin.vpk               <-- 후보 2: 단일 VPK 파일
    // │   ├── Multi_Parts_Pack/           <-- 후보 3: 다중 파일 조합 팩 (폴더)
    // │   │   ├── model.vpk
    // │   │   └── sound.vpk
    // │   └── _disabled/                  <-- 【밑줄 무시】: _ 로 시작하는 폴더는 자동으로 무시됩니다
    // │       ├── Old_Skin.vpk            <-- 안의 파일은 마운트되지 않습니다
    // │       └── Test.vpk
    // └── Survivors_Rochelle/
    //     ├── Outfit_A.vpk
    //     └── _temp.vpk                   <-- 【밑줄 무시】: _ 로 시작하는 파일도 무시됩니다
    //
    // overlay_root 아래의 각 하위 폴더는 하나의 교체 항목에 해당합니다.
    // 여러 .vpk가 들어 있는 폴더가 선택되면 그 폴더 안의 모든 VPK가 동시에 로드됩니다.
    // 밑줄 "_"로 시작하는 파일이나 폴더는 스캔 시 바로 건너뛰며 후보 라이브러리에 포함되지 않습니다.
    //
    // 주의: 이 기능은 현재 파일 충돌 검사가 없습니다. 발생할 수 있는 충돌 문제에 대응하려면 기본적인 모드 파일 점검 능력이 필요합니다
    //      라이브러리에 넣는 VPK 파일은 명확한 단일 기능을 갖도록 하여 다른 모드와 충돌할 가능성을 줄이세요
    //      위 내용이 무슨 말인지 모르겠다면 무기 모드만 사용하는 것을 권장합니다
    //
    // 라이브러리 파일을 준비한 뒤 맵에 들어가서 l4n의 hud 메뉴를 열어 이 기능에 접근하세요
    // 각 Overlay 단위는 다음 전환 규칙을 독립적으로 설정할 수 있습니다:
    //      무작위 비반복(RandomNoRepeat): 무작위로 선택하되, 이번에 선택된 내용이 이전과 겹치지 않도록 보장합니다.
    //      완전 무작위(Random): 매번 순수하게 무작위로 VPK 하나 또는 조합 팩 하나를 선택합니다.
    //      순서 모드(Sequential): 이름의 알파벳 순서대로 차례로 순환하며 로드합니다.
    //      고정 모드(Lock): 현재 선택된 모드를 고정하고, 맵 변경이나 재로드 시 더 이상 전환하지 않습니다.
    // 다음 사용 지정(Designate Next):
    //      특정 VPK 파일이나 폴더가 다음 맵 변경 시 반드시 적용되도록 미리 지정할 수 있습니다. 해당 마운트가 완료되면 시스템이 원래의 전환 규칙으로 자동 복귀합니다.

    // 환경 변수 설정
    "environment_variables" {
        // vulkan loader의 환경 변수
        // DXVK와 ReShade Bridge를 사용하는 경우, 아래 두 매개변수로 메모리 점유 이상 문제를 해결할 수 있습니다. 아래 두 줄 앞의 "//"를 삭제하면 매개변수가 적용됩니다
        // "VK_LOADER_LAYERS_DISABLE" "*"               // 블랙리스트. 매개변수 "*"는 vulkan layer 메커니즘에 의존하는 모든 기능을 비활성화합니다. 예: RTSS(MSI Afterburner), OBS 게임 캡처, ReShade
        // "VK_LOADER_LAYERS_ENABLE" "*reshade*,*obs*"  // 화이트리스트. 블랙리스트보다 우선순위가 높습니다
        // 정확한 원인은 아직 밝혀지지 않았지만 확실히 문제가 해결됩니다...

        // "DISABLE_VK_LAYER_reshade_1" "1" // vulkan 모드에서 ReShade를 완전히 비활성화
    }

    // 사용자 지정 명령. l4n_custom_command_menu로 엽니다
    "custom_commands" {
        "1인칭 엔티티 렌더링" { "cvar" "r_drawviewmodel" }
        "디렉터 시스템 정지" { "cmd" "sv_cheats 1;director_stop" }
        "HUD 네트워크 상태" {
            "cvar" "net_graph"
            "delta" "1"
            "min" "0"
            "max" "3"
        }
        "치트 활성화(로비 게임 제한 무시)" { "cmd" "l4n_allow_lobby_cheats 1;sv_cheats 1" }
        "총구 흔들림 비활성화" { "cmd" "l4n_cvar z_gun_vertical_punch 0" }
        "무력화(체력 0)" { "cmd" "l4n_allow_lobby_cheats 1;sv_cheats 1;ent_fire !self sethealth 0" }
        "엔티티 외곽선" { "cvar" "sv_glowenable" }
        "엔티티 렌더링" { "cvar" "r_drawentities" }
        "정적 프롭 렌더링" { "cvar" "r_drawstaticprops" }
        "데칼 렌더링" { "cvar" "r_drawdecals" }
        // 흥미로운 convar와 concmd 몇 가지
        // r_cleardecals 
        // r_decals 2
        // vm_debug 1
        // vm_draw_addon 0
    }

    // 엔진 내장 브라우저 커널을 비활성화할지 여부. 메모리 점유를 100MB 정도 절약할 수 있습니다
    // 일부 서버의 환영 페이지가 표시되지 않게 됩니다
    "disable_chromehtml" "0"

    // Too many indices for index buffer 팝업을 방지하는 데 사용됩니다
    // 2로 조정한 뒤 맵에 들어가 효과를 테스트할 수 있습니다. 기본값(32768)이 아닌 값은 부작용(폴리곤 깨짐, 화면 얼룩, 화면 찢어짐)이 있을 수 있습니다
    // 비슷한 패치를 적용했다면 기본값을 유지하면 됩니다
    "index_buffer_size" "32768" // 폴리곤 깨짐은 수치 크기와 관련이 있는 것으로 보이며, 32768의 배수를 시도해볼 수 있습니다: 65535 131072

    // vertex buffer 관련 팝업은 매우 드뭅니다. 부득이한 경우가 아니라면, 기본값(32768)보다 크게 하면 폴리곤 깨짐과 화면 얼룩이 발생합니다
    "vertex_buffer_size" "32768" // 권장값 65535

    "font" // 글꼴 설정
    {
        "anti_aliasing" "1"
        //"min_tall" "20" // 글꼴의 최소 크기. 게임 내 일부 텍스트가 너무 작아지는 것을 방지합니다
        "replace" // 글꼴 교체 목록
        {
            // 작성법: "교체될 글꼴" "대체 글꼴" 
            // Tahoma를 Microsoft YaHei(微软雅黑)로 교체하는 예시. 중국어 간체의 기본 글꼴은 Tahoma입니다
            // "Tahoma" "微软雅黑" 

            // 일부 HUD 모드는 기본 글꼴을 다른 것으로 변경합니다. HUD 모드를 언팩하여 사용 중인 글꼴 이름을 확인한 뒤 교체할 수 있습니다
            // "HUD가 사용하는 글꼴 이름" "微软雅黑" 

            // english의 기본 글꼴은 L4D 시리즈의 낡은 스타일에 어울리는 Stubble bold입니다
            // "Stubble bold" "微软雅黑" 

            "Fixedsys" "Pretendard Medium"
            "SimSun" "Pretendard Medium"
            "NSimSun" "Pretendard Medium"
            "SimSun-ExtB" "Pretendard Medium"
            "Batang" "Pretendard Medium"
            "MingLiU" "Pretendard Medium"
            "MingLiU-ExtB" "Pretendard Medium"
            "PMingLiU" "Pretendard Medium"
            "PMingLiU-ExtB" "Pretendard Medium"
            "PMingLiU_HKSCS" "Pretendard Medium"
            "PMingLiU_HKSCS-ExtB" "Pretendard Medium"
            "MS Mincho" "Pretendard Medium"
            "MS PMincho" "Pretendard Medium"
            "Microsoft Sans Serif" "Pretendard Medium"
            "Arial" "Pretendard Medium"
            "Arial Black" "Pretendard Medium"
            "Arial Narrow" "Pretendard Medium"
            "Arial Unicode MS" "Pretendard Medium"
            "Lucida Sans Unicode" "Pretendard Medium"
            "Segoe UI" "Pretendard Medium"
            "Calibri" "Pretendard Medium"
            "Courier" "Pretendard Medium"
            "Tahoma" "Pretendard Medium"
            "Terminal" "Pretendard Medium"
            "MS Sans Serif" "Pretendard Medium"
            "MS Serif" "Pretendard Medium"
            "Verdana" "Pretendard Medium"
        }
    }

    // 시작 옵션은 프로그램 시작 시 프로그램에 전달되는 정보입니다. 즉, 실행 주체가 프로그램을 시작할 때 전달해야 합니다
    // 게임을 steam을 통해 실행하지 않는다면 steam에 설정한 시작 옵션은 적용되지 않습니다
    // bat이나 바로가기에도 시작 옵션을 추가하는 기능이 있으며, 제약은 steam 실행과 동일합니다
    "launch_options"
    {
        // 추가 시작 옵션. l4n이 활성화된 상태에서만 유효합니다
        // 문법: 
        // "-novid"는 다음과 같이 작성: "-novid" "" 
        // "+mat_phong 1"은 다음과 같이 작성: "+mat_phong" "1" 

        "-l4n_use_neko_engine_post" ""

        // "-novid" "" // 게임 시작 시 나오는 Valve 애니메이션과 맛있는 초콜릿 헬리콥터를 끕니다

        // "-lv" "" // 저혈흔 모드. 일부 혈흔 이펙트로 인한 크래시를 방지합니다. 예: 특수 감염자가 할퀼 때 몸에 묻는 혈흔 데칼

        // 아래는 l4n이 활성화된 상태에서만 사용할 수 있는 시작 옵션입니다
        // "-hide_addons" ""            // 엔진이 addons 디렉터리의 파일을 읽는 것을 금지합니다
        // "-l4n_use_neko_engine_post" "" // 추가하면 l4n이 엔진의 후처리 렌더링을 대신 처리합니다
        // "-no_l4n_gui" ""
        // "-no_l4n_vgui" ""
        // "-mat_utf8" ""

        // ！！！！아래 시작 옵션은 이 파일에 추가할 수 없습니다. steam 게임 속성이나 다른 방식(bat, 바로가기)으로 설정하세요！！！！
            // -hide_neko                   // l4n 비활성화. 플랫폼이 비활성화되면 이 설정 파일은 무효가 되며, 시작 옵션을 옮겨야 할 수 있습니다
            // -hide_nekoshaders            // l4n의 셰이더 비활성화
            // -l4n_no_compatibility_check  // l4n의 게임 버전 검사 금지
            // -l4n_no_crash_handler        // L4N의 크래시 핸들러 비활성화 (config.vdf에서는 무효)
    }

    // l4n_menu를 "\" 키에 강제로 바인딩할지 여부
    "force_bind_l4n_menu" "1"

    // datacache의 상한을 2048MB로 강제 설정
    "lock_datacache_size" "1"

    "logging_system_log" "1"    // 게임의 모든 채널 로그를 logging_system.log에 기록합니다

// ==================== 자신이 무엇을 하는지 확실히 알지 못한다면, 이 줄부터 파일 끝까지의 내용을 수정하지 마세요 ========================

    // 엔진 tier0 내장 메모리 할당자를 mimalloc 메모리 할당자로 교체할지 여부
    // 이 기능은 실험적이며, 게임의 메모리 수요 할당을 위해 큰 메모리 블록을 미리 확보합니다
    // mimalloc은 높은 주소부터 메모리를 할당하는 경향이 있어 게임 객체의 메모리 배치가 크게 바뀌며, 평소에는 잘 드러나지 않는 버그가 노출될 수 있습니다
    // 평소 DC 점유가 높은 편이라면 이 기능 사용을 권장하지 않습니다. 이 기능은 현재 dxvk의 메모리 할당자를 교체하지 않기 때문에 메모리 부족 크래시가 발생하기 쉽습니다
    "mimalloc" "1"

    "wave_cache_max_kilobytes" "524288" // 512mb

    "generate_addoninfo" "1"

    "survivors" {
        "nick" {
            // l4n_survivor_sequence_strip은 번호가 max_sequences보다 큰 애니메이션을 잘라내어, 확장된 애니메이션이 호출되는 것을 방지합니다
            "max_sequences" "923"
        }
        "ellis" {
            "max_sequences" "927"
        }
        "rochelle" {
            "max_sequences" "930"
        }
        "coach" {
            "max_sequences" "912"
        }
        "bill" {
            "max_sequences" "1013"
        }
        "louis" {
            "max_sequences" "1013"
        }
        "francis" {
            "max_sequences" "1016"
        }
        "zoey" {
            "max_sequences" "947"
        }
    }

}
