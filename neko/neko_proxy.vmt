"新增的材质代理们"
{
    "PlayerBottom" // 시선 방향과 캐릭터 모델 엔티티의 루트 본 축 방향의 차이를 가져옵니다
    {
        "resultVar"         "$alpha2"
    }
    "Sequence"  // 애니메이션 엔티티가 현재 재생 중인 애니메이션 인덱스를 가져옵니다
    {
        "layer"         "-1"         // 가져올 애니메이션 재생 레이어를 지정합니다. -1은 기본값 사용
        // (v모델(1인칭 무기) 엔티티라면 0으로 설정하여 reload나 fire 등을 가져올 수 있습니다. 콘솔에서 "vm_debug 1"을 실행하여 확인하세요),
        "resultVar" 	"$number"
    }
    "PlayerAttachment" // 시선 방향과 엔티티 Attachment의 축 방향 차이를 가져옵니다
    { // 이 예시 매개변수는 비침 처리된 눈썹을 측면에서 사라지게 하는 데 사용할 수 있습니다(2단계 중 1)
        "name" "eyes"
        "axis" "1"      // 1~3, Attachment의 어느 축을 기준으로 사용할지 설정합니다
        "resultVar"         "$eyebrowalpha"
    }

    // https://developer.valvesoftware.com/wiki/List_of_material_proxies
    // 아래는 wiki에서 참고 자료를 찾을 수 있는 프록시들입니다
    "RemapValClamp"	// 수치 범위 매핑
    { // 이 예시 매개변수는 비침 처리된 눈썹을 측면에서 사라지게 하는 데 사용할 수 있습니다(2단계 중 2)
        "range_in_min" 	"-0.15"
        "range_in_max" 	"-0.5"
        "range_out_min" "0"
        "range_out_max" "0.2"
        "srcVar1" 		"$eyebrowalpha"
        "resultVar" 	"$eyebrowalpha"
    }
    "ClipAmmo"	// 탄창에 남은 탄약을 가져옵니다
    {
        "resultVar"         "$number"
    }
    "RemainingAmmo"	// 남은 예비 탄약을 가져옵니다
    {
        "resultVar"         "$number"
    }
    "Cycle"	// 엔티티의 애니메이션 진행도를 가져옵니다
    {
        "layer"             "-1" // 애니메이션 재생 레이어를 지정합니다(1인칭 무기라면 0을 입력해야 합니다)
        "start"             "0.0"
        "end"               "1.0"
        "easein"            "1"
        "easeout"           "1"
        "resultVar"         "$number"
    }
    "Modulo" // 나머지 연산
    {
        "srcVar1"           "1145"
        "srcVar2"           "14"
        "resultVar"         "$number"
    }
    "SelectFirstIfNonZero"
    {
        "srcVar1" ""
        "srcVar2" ""
        "resultVar" ""
    }
}